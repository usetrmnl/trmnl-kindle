 wifi_up() {
   # A loaded interface allows the existing fetch path even when ICMP is blocked.
   "$DIR/wait-for-wifi.sh" "$WIFI_TEST_ADDRESS" || [ -e /sys/class/net/wlan0 ]
+  TRMNL_TEST_WIFI_RESULT=$?
